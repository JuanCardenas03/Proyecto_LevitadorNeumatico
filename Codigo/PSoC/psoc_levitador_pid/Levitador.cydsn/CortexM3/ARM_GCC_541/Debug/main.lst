   1:main.c        **** /* ============================================================================
   2:main.c        ****  * main.c  -  Firmware del levitador neumatico en la PSoC 5LP (CY8CKIT-059)
   3:main.c        ****  *            Esclavo Modbus RTU + control PID de altura
   4:main.c        ****  *
   5:main.c        ****  *  ESP32 --RS485--> MAX485 #2 --> UART_RS485 (19200 8N1) --> esclavo Modbus
   6:main.c        ****  *  HC-SR04 --> hw_levitador (eco por interrupcion) --> control.c (PID 25 Hz)
   7:main.c        ****  *  control.c --> PWM_Fan (25 kHz) --> IRLZ44N --> ventilador
   8:main.c        ****  *  UART_DBG (115200, KitProg) --> log, consola y Serial Plotter
   9:main.c        ****  *
  10:main.c        ****  *  El bucle principal no bloquea (lo mas largo son los 10 us del TRIG):
  11:main.c        ****  *    1) recepcion RS485 y respuesta Modbus (primero se responde, luego el log)
  12:main.c        ****  *    2) consola
  13:main.c        ****  *    3) control: disparo del HC-SR04 cada 40 ms; el paso del PID se ejecuta
  14:main.c        ****  *       en cuanto llega el eco (o a los 15 ms si no llega)
  15:main.c        ****  *
  16:main.c        ****  *  Seguridad:
  17:main.c        ****  *    - EMG = 1 o EN = 0 por Modbus: PWM a 0 en el mismo instante.
  18:main.c        ****  *    - Sin tramas validas del maestro durante 1.5 s (habiendo tenido enlace):
  19:main.c        ****  *      EN = 0 (timeout de seguridad, Guia v3 Seccion 0). Para reanudar el
  20:main.c        ****  *      HMI vuelve a enviar EN:1.
  21:main.c        ****  *    - Sensor sin eco ~0.8 s con el lazo cerrado: EN = 0 (control.c).
  22:main.c        ****  * ==========================================================================*/
  23:main.c        **** #include "project.h"
  24:main.c        **** #include <stdint.h>
  25:main.c        **** #include "modbus_slave.h"
  26:main.c        **** #include "control.h"
  27:main.c        **** #include "hw_levitador.h"
  28:main.c        **** #include "planta_modelo.h"
  29:main.c        **** #include "debug_log.h"
  30:main.c        **** #include "consola.h"
