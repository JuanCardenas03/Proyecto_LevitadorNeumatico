  28              		.file 1 "control.c"
   1:control.c     **** /* ============================================================================
   2:control.c     ****  * control.c  -  Control de ALTURA del levitador (PID + feedforward)
   3:control.c     ****  *
   4:control.c     ****  * Las formulas son las de levitador_esp32_PID.ino (pidPaso, medicion con
   5:control.c     ****  * mediana de 3 y rechazo de atipicos, entrarPID, paro, rampa y barrido).
   6:control.c     ****  * Cambios por estar en la PSoC:
   7:control.c     ****  *   - El setpoint, las ganancias, el modo y el duty manual se leen de los
   8:control.c     ****  *     holding registers; EN, RST y EMG de los coils (Guia v3, Seccion 4).
   9:control.c     ****  *   - La calibracion del fondo no bloquea (se reparte en pasos de 40 ms)
  10:control.c     ****  *     para no dejar de responder Modbus.
  11:control.c     ****  *   - El paro de seguridad del sensor pone EN = 0 (hay que volver a
  12:control.c     ****  *     habilitar desde el HMI, igual que en la ESP32 habia que dar otro sp).
  13:control.c     ****  *   - Manual -> auto: el duty manual inicializa el integrador; uFF no cambia
  14:control.c     ****  *     (en el .ino se adoptaba como uFF).
  15:control.c     ****  *   - Sin math.h: abs y redondeo propios (no hace falta enlazar libm).
  16:control.c     ****  * ==========================================================================*/
  17:control.c     **** #include "control.h"
  18:control.c     **** #include <string.h>
  19:control.c     **** 
  20:control.c     **** #define TS_S           ((float)CTRL_TS_MS / 1000.0f)
  21:control.c     **** #define CAL_MUESTRAS   15u
  22:control.c     **** #define BANDA_OBJ_X10  5       /* +/- 5 mm (bit 1 del estado) */
  23:control.c     **** #define FALLOS_SENSOR  3u      /* con 3 fallos seguidos el sensor "no esta OK" */
  24:control.c     **** #define FUERA_RANGO_CM 2.0f    /* pelota mas de 2 cm por encima de spMax */
  25:control.c     **** 
  26:control.c     **** typedef struct {
  27:control.c     ****     ctrl_info_t v;
  28:control.c     ****     float    alturaPrev;
  29:control.c     ****     float    buf[3];
ARM GAS  C:\Users\Usuario\AppData\Local\Temp\ccdrsAcu.s 			page 2


  30:control.c     ****     uint8_t  idx;
  31:control.c     ****     float    t_modo;        /* s transcurridos en rampa o barrido     */
  32:control.c     ****     float    alt0;          /* altura al iniciar la rampa             */
  33:control.c     ****     uint16_t hr0_rampa;     /* ultimo HR0 escrito por la rampa        */
  34:control.c     ****     uint16_t hr0_aviso;     /* ultimo HR0 avisado como recortado      */
  35:control.c     ****     uint8_t  rst_prev;
  36:control.c     ****     uint8_t  pide_rampa;
  37:control.c     ****     uint8_t  pide_barrido;
  38:control.c     ****     uint16_t cal_espera;    /* pasos de espera antes de muestrear     */
  39:control.c     ****     uint16_t cal_i;
  40:control.c     ****     uint16_t cal_n;
  41:control.c     ****     float    cal_suma;
  42:control.c     ****     uint16_t eventos;
