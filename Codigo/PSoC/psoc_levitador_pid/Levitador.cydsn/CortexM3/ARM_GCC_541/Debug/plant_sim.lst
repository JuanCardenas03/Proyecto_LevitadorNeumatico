   1:plant_sim.c   **** /* ============================================================================
   2:plant_sim.c   ****  * plant_sim.c  -  Planta simulada de primer orden
   3:plant_sim.c   ****  *
   4:plant_sim.c   ****  *  - EN = 0 o EMG = 1 : PWM = 0, la pelota cae.
   5:plant_sim.c   ****  *  - Modo auto (HR4=1): la altura va al setpoint (tau 0.8 s); el PWM se
   6:plant_sim.c   ****  *                       calcula como equilibrio + ganancia * error.
   7:plant_sim.c   ****  *  - Modo manual      : PWM = HR5; la altura sigue una curva PWM -> altura.
   8:plant_sim.c   ****  *
   9:plant_sim.c   ****  * Es solo para probar la comunicacion; NO es un modelo fisico del levitador.
  10:plant_sim.c   ****  * ==========================================================================*/
  11:plant_sim.c   **** #include "plant_sim.h"
  12:plant_sim.c   **** #include <string.h>
  13:plant_sim.c   **** 
  14:plant_sim.c   **** #define PWM_EQUILIBRIO   550.0f   /* PWM con el que "flota" (por mil)     */
  15:plant_sim.c   **** #define PWM_GANANCIA     1.5f     /* por mil de PWM por cada mm de error   */
  16:plant_sim.c   **** #define PWM_MIN_LEVANTA  400.0f   /* debajo de esto la pelota no sube      */
  17:plant_sim.c   **** #define TAU_AUTO         0.8f     /* s */
  18:plant_sim.c   **** #define TAU_MANUAL       0.6f     /* s */
  19:plant_sim.c   **** #define TAU_CAIDA        0.4f     /* s */
  20:plant_sim.c   **** #define BANDA_OBJETIVO   5        /* +/- 5 mm = 5 en cm x 10 (Seccion 4.6) */
  21:plant_sim.c   **** 
  22:plant_sim.c   **** static float            alt_sim;   /* cm x 10 */
  23:plant_sim.c   **** static float            pwm_sim;   /* por mil */
  24:plant_sim.c   **** static plant_override_t ov;
  25:plant_sim.c   **** static uint8_t          rst_prev;
  26:plant_sim.c   **** static uint16_t         rst_cuenta;
  27:plant_sim.c   **** 
