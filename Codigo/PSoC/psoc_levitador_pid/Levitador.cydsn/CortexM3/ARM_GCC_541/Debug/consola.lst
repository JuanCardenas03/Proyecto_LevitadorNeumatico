   1:consola.c     **** /* ============================================================================
   2:consola.c     ****  * consola.c  -  Comandos por el puerto de depuracion (115200, CR o LF)
   3:consola.c     ****  *
   4:consola.c     ****  * Los comandos de control son los mismos del monitor serie de la ESP32-PID
   5:consola.c     ****  * (sp=, u=, ff=, kp=, ki=, kd=, fl=, a, b, c, d, p). Se aceptan "sp=15" y
   6:consola.c     ****  * "sp 15". Escriben los MISMOS registros que escribe el maestro Modbus, asi
   7:consola.c     ****  * que el HMI ve los cambios.
   8:consola.c     ****  * ==========================================================================*/
   9:consola.c     **** #include "project.h"
  10:consola.c     **** #include "consola.h"
  11:consola.c     **** #include "debug_log.h"
  12:consola.c     **** #include "control.h"
  13:consola.c     **** #include <string.h>
  14:consola.c     **** #include <ctype.h>
  15:consola.c     **** 
  16:consola.c     **** #define LINEA_MAX 48u
  17:consola.c     **** 
  18:consola.c     **** static char    linea[LINEA_MAX];
  19:consola.c     **** static uint8_t n_linea;
  20:consola.c     **** 
  21:consola.c     **** void consola_ayuda(void)
  22:consola.c     **** {
  23:consola.c     ****     dbg_puts("Comandos de control:\r\n"
  24:consola.c     ****              "  sp 15 | 15 | sp 50%  setpoint (cm o % de la altura util); EN=1, modo auto\r\n"
  25:consola.c     ****              "  u 51          MANUAL con duty en % (buscar el duty de flote)\r\n"
  26:consola.c     ****              "  ff 49         feedforward de sostenimiento (%); solo cambia por aqui\r\n"
  27:consola.c     ****              "  kp 1.0 | ki 0.6 | kd 0.05  ganancias (% de duty por cm)\r\n"
  28:consola.c     ****              "  fl 20         piso de duty en vuelo (%)\r\n"
ARM GAS  C:\Users\Usuario\AppData\Local\Temp\ccBd37Ki.s 			page 2


  29:consola.c     ****              "  p             paro (EN=0)      rst   reinicia el integrador\r\n"
  30:consola.c     ****              "  en 0|1  emg 0|1  modo 0|1     coils / modo, igual que el HMI\r\n"
  31:consola.c     ****              "  a             rampa del sp hasta el maximo en 30 s\r\n"
  32:consola.c     ****              "  b             barrido PWM 0->100 % en 30 s (lazo abierto)\r\n"
  33:consola.c     ****              "  c             recalibrar el fondo (pelota abajo, ventilador apagado)\r\n"
  34:consola.c     ****              "  plot 0|1      salida para Serial Plotter (sp,altura,pwm)   d  +distancia\r\n"
  35:consola.c     ****              "  fuente real|sim  sensor real o planta simulada (ventilador apagado)\r\n"
  36:consola.c     ****              "Comunicacion:\r\n"
  37:consola.c     ****              "  etapa 0|1  log 0|1|2  mute 0|1  dump  reset  help\r\n");
  38:consola.c     **** }
