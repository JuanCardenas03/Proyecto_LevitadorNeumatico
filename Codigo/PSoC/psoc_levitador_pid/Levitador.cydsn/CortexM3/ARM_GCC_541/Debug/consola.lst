  62:consola.c     ****                ctrl_nombre_modo(ci->modo),
  63:consola.c     ****                fx(ctrl_redondear(ci->sp * 100.0f), 2u),
  64:consola.c     ****                fx(ctrl_redondear(ci->altura * 10.0f), 1u),
  65:consola.c     ****                fx(ctrl_redondear(ci->duty * 10.0f), 1u),
  66:consola.c     ****                fx(ctrl_redondear(ci->I * 100.0f), 2u));
  67:consola.c     ****     dbg_printf("  uFF=%s %%  piso=%s %%  base=%s cm  spMax=%s cm  dist=%s cm  fallos=%u\r\n",
  68:consola.c     ****                fx(ctrl_redondear(ci->uFF * 10.0f), 1u),
  69:consola.c     ****                fx(ctrl_redondear(ci->piso * 10.0f), 1u),
  70:consola.c     ****                fx(ctrl_redondear(ci->base * 10.0f), 1u),
  71:consola.c     ****                fx(ctrl_redondear(ci->spMax * 10.0f), 1u),
  72:consola.c     ****                fx(ctrl_redondear(ci->dist * 10.0f), 1u),
  73:consola.c     ****                ci->fallos);
  74:consola.c     ****     dbg_printf("---- etapa=%u log=%u mute=%u fuente=%s plot=%u | pulsos RST=%u\r\n",
  75:consola.c     ****                cfg->etapa, cfg->log_nivel, cfg->mute,
  76:consola.c     ****                (cfg->fuente == FUENTE_SIM) ? "sim" : "real", cfg->plot,
  77:consola.c     ****                ci->pulsos_rst);
  78:consola.c     **** }
