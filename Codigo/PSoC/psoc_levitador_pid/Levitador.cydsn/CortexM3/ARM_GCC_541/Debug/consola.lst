  45:consola.c     ****     dbg_puts("---- Holding registers ----\r\n");
  46:consola.c     ****     for (i = 0u; i < MB_NUM_HR; i++) {
  47:consola.c     ****         dbg_printf("  HR%u %-12s = %-10s [%u]\r\n", i, nombre_hr(i),
  48:consola.c     ****                    fmt_hr(i, d->hr[i]), d->hr[i]);
  49:consola.c     ****     }
  50:consola.c     ****     dbg_puts("---- Input registers ----\r\n");
  51:consola.c     ****     for (i = 0u; i < MB_NUM_IR; i++) {
  52:consola.c     ****         dbg_printf("  IR%u %-16s = %-10s [%u]\r\n", i, nombre_ir(i),
  53:consola.c     ****                    fmt_ir(i, d->ir[i]), d->ir[i]);
  54:consola.c     ****     }
  55:consola.c     ****     dbg_puts("---- Coils ----\r\n");
  56:consola.c     ****     for (i = 0u; i < MB_NUM_COILS; i++) {
  57:consola.c     ****         dbg_printf("  C%u  %-17s = %s\r\n", i, nombre_coil(i),
  58:consola.c     ****                    (d->coil[i] != 0u) ? "ON" : "OFF");
  59:consola.c     ****     }
  60:consola.c     ****     dbg_puts("---- Control ----\r\n");
