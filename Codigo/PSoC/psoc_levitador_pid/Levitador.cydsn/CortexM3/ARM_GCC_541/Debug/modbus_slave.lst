 107:modbus_slave.c ****     }
 108:modbus_slave.c ****     ini  = rd16(&q[2]);
 109:modbus_slave.c ****     cant = rd16(&q[4]);
 110:modbus_slave.c ****     ev->dir  = ini;
 111:modbus_slave.c ****     ev->cant = cant;
 112:modbus_slave.c **** 
