  99:modbus_slave.c **** static uint16_t leer_registros(const uint16_t *tabla, uint16_t ntabla,
 100:modbus_slave.c ****                                const uint8_t *q, uint16_t len,
 101:modbus_slave.c ****                                uint8_t *r, mb_event_t *ev)
 102:modbus_slave.c **** {
 103:modbus_slave.c ****     uint16_t i, ini, cant;
 104:modbus_slave.c **** 
 105:modbus_slave.c ****     if (len != 8u) {
