 115:modbus_slave.c ****     }
 116:modbus_slave.c ****     if (((uint32_t)ini + cant) > ntabla) {
ARM GAS  C:\Users\Usuario\AppData\Local\Temp\ccPc27IF.s 			page 8


 117:modbus_slave.c ****         return excepcion(r, q[1], MB_EXC_DIRECCION, ev);
