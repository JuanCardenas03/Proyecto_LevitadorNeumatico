   1:main.c        **** /* ============================================================================
   2:main.c        ****  * main.c  -  Firmware de PRUEBA de comunicacion Modbus RTU para la PSoC 5LP
   3:main.c        ****  *            (CY8CKIT-059) - Levitador neumatico
   4:main.c        ****  *
   5:main.c        ****  *  ESP32 --RS485--> MAX485 #2 --> UART_RS485 (19200 8N1) --> esclavo Modbus
   6:main.c        ****  *                                         |
   7:main.c        ****  *                                         +--> UART_DBG (115200) --> KitProg
   8:main.c        ****  *
   9:main.c        ****  *  Etapa 0: sniffer pasivo. Muestra cada trama en hex con su CRC. No responde.
  10:main.c        ****  *  Etapa 1: esclavo Modbus con el mapa v2 + planta simulada.
  11:main.c        ****  *  Se cambia en caliente con el comando "etapa 0|1" en el monitor serie.
  12:main.c        ****  *
  13:main.c        ****  *  Regla: primero se RESPONDE por RS485 y despues se escribe el log.
  14:main.c        ****  *  Ningun printf dentro de interrupciones.
  15:main.c        ****  *
  16:main.c        ****  *  Componentes requeridos en TopDesign (ver README):
  17:main.c        ****  *    UART_RS485, UART_DBG, Pin_LED (P2[1], LED de la placa)
  18:main.c        ****  * ==========================================================================*/
  19:main.c        **** #include "project.h"
  20:main.c        **** #include <stdint.h>
  21:main.c        **** #include "modbus_slave.h"
  22:main.c        **** #include "plant_sim.h"
  23:main.c        **** #include "debug_log.h"
  24:main.c        **** #include "consola.h"
  25:main.c        **** 
