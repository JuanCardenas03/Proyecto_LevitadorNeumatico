   1:modbus_slave.c **** /* ============================================================================
   2:modbus_slave.c ****  * modbus_slave.c  -  Esclavo Modbus RTU (logica pura, sin hardware)
   3:modbus_slave.c ****  * ==========================================================================*/
   4:modbus_slave.c **** #include "modbus_slave.h"
   5:modbus_slave.c **** #include <string.h>
   6:modbus_slave.c **** 
   7:modbus_slave.c **** /* Rango permitido por holding (Seccion 4.3). Fuera de rango -> excepcion 03 */
   8:modbus_slave.c **** static const uint16_t hr_max[MB_NUM_HR] = {
   9:modbus_slave.c ****     1000u,   /* Setpoint  cm x 10 (0-100 cm) */
  10:modbus_slave.c ****     65535u,  /* Kp x 100 */
  11:modbus_slave.c ****     65535u,  /* Ki x 100 */
  12:modbus_slave.c ****     65535u,  /* Kd x 100 */
  13:modbus_slave.c ****     1u,      /* Modo 0 = manual, 1 = auto */
  14:modbus_slave.c ****     1000u    /* PWM manual por mil */
  15:modbus_slave.c **** };
  16:modbus_slave.c **** 
  17:modbus_slave.c **** uint16_t mb_hr_max(uint16_t dir)
  18:modbus_slave.c **** {
  19:modbus_slave.c ****     return (dir < MB_NUM_HR) ? hr_max[dir] : 0u;
  20:modbus_slave.c **** }
  21:modbus_slave.c **** 
  22:modbus_slave.c **** /* CRC-16 Modbus, polinomio 0xA001, valor inicial 0xFFFF */
  23:modbus_slave.c **** uint16_t mb_crc16(const uint8_t *buf, uint16_t len)
  24:modbus_slave.c **** {
  25:modbus_slave.c ****     uint16_t crc = 0xFFFFu;
  26:modbus_slave.c ****     uint16_t i;
  27:modbus_slave.c ****     uint8_t  b;
  28:modbus_slave.c **** 
  29:modbus_slave.c ****     for (i = 0u; i < len; i++) {
  30:modbus_slave.c ****         crc ^= buf[i];
  31:modbus_slave.c ****         for (b = 0u; b < 8u; b++) {
ARM GAS  C:\Users\Usuario\AppData\Local\Temp\cc1bMuOj.s 			page 2


  32:modbus_slave.c ****             if ((crc & 1u) != 0u) {
  33:modbus_slave.c ****                 crc = (uint16_t)((crc >> 1) ^ 0xA001u);
  34:modbus_slave.c ****             } else {
  35:modbus_slave.c ****                 crc >>= 1;
  36:modbus_slave.c ****             }
  37:modbus_slave.c ****         }
  38:modbus_slave.c ****     }
  39:modbus_slave.c ****     return crc;
  40:modbus_slave.c **** }
  41:modbus_slave.c **** 
  42:modbus_slave.c **** void mb_sync(mb_data_t *d)
  43:modbus_slave.c **** {
  44:modbus_slave.c ****     d->ir[IR_SETPOINT]  = d->hr[HR_SETPOINT];   /* contrato v2: IR0 = HR0 */
  45:modbus_slave.c ****     d->ir[IR_TRAMAS_OK] = d->tramas_ok;
  46:modbus_slave.c ****     d->ir[IR_ERR_CRC]   = d->errores_crc;
  47:modbus_slave.c **** }
  48:modbus_slave.c **** 
  49:modbus_slave.c **** void mb_init(mb_data_t *d)
  50:modbus_slave.c **** {
  51:modbus_slave.c ****     memset(d, 0, sizeof(*d));
  52:modbus_slave.c ****     /* Valores de arranque (los mismos ejemplos de la guia) */
  53:modbus_slave.c ****     d->hr[HR_KP]   = 40u;   /* 0.40 */
  54:modbus_slave.c ****     d->hr[HR_KI]   = 104u;  /* 1.04 */
  55:modbus_slave.c ****     d->hr[HR_KD]   = 22u;   /* 0.22 */
  56:modbus_slave.c ****     d->hr[HR_MODO] = 1u;    /* automatico */
  57:modbus_slave.c ****     mb_sync(d);
  58:modbus_slave.c **** }
