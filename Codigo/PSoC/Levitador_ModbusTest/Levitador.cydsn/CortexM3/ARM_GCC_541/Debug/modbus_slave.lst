  96:modbus_slave.c **** static uint16_t leer_registros(const uint16_t *tabla, uint16_t ntabla,
  97:modbus_slave.c ****                                const uint8_t *q, uint16_t len,
  98:modbus_slave.c ****                                uint8_t *r, mb_event_t *ev)
  99:modbus_slave.c **** {
 100:modbus_slave.c ****     uint16_t i, ini, cant;
