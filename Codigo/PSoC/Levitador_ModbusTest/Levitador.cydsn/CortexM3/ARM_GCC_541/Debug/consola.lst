   1:consola.c     **** /* ============================================================================
   2:consola.c     ****  * consola.c  -  Comandos por el puerto de depuracion
   3:consola.c     ****  *
   4:consola.c     ****  * Escriba en el monitor serie (115200, fin de linea CR o LF):
   5:consola.c     ****  *   help            lista de comandos
   6:consola.c     ****  *   etapa 0|1       0 = sniffer pasivo, 1 = esclavo Modbus
   7:consola.c     ****  *   log 0|1|2       0 silencio, 1 escrituras + resumen/s, 2 todo en hex
   8:consola.c     ****  *   alt <v>         fija la altura (cm x 10). Ej: alt 226 -> 22.6 cm
   9:consola.c     ****  *   err <v>         fuerza el error (cm x 10, con signo). Ej: err -35
  10:consola.c     ****  *   est <v>         fuerza la palabra de estado. Ej: est 0x21
  11:consola.c     ****  *   sim             quita todo lo forzado (vuelve la planta simulada)
  12:consola.c     ****  *   mute 0|1        1 = la PSoC deja de responder (enlace caido)
  13:consola.c     ****  *   dump            imprime todos los registros
  14:consola.c     ****  *   reset           pone en cero los contadores de tramas y CRC
  15:consola.c     ****  * ==========================================================================*/
  16:consola.c     **** #include "project.h"
  17:consola.c     **** #include "consola.h"
  18:consola.c     **** #include "debug_log.h"
  19:consola.c     **** #include "plant_sim.h"
  20:consola.c     **** #include <stdlib.h>
  21:consola.c     **** #include <string.h>
  22:consola.c     **** #include <ctype.h>
  23:consola.c     **** 
  24:consola.c     **** #define LINEA_MAX 48u
  25:consola.c     **** 
  26:consola.c     **** static char    linea[LINEA_MAX];
  27:consola.c     **** static uint8_t n_linea;
  28:consola.c     **** 
